<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="katalog.MainWindow"
        Title="Katalog zbioru">
  <StackPanel Margin="10" Spacing="8">
    <TextBlock Text="Katalog własnego zbioru" FontSize="22" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Click="OnListClick">Lista</Button>
      <Button Click="OnDetailClick">Szczegóły</Button>
      <Button Click="OnAddClick">Dodaj</Button>
      <Button Click="OnCountClick">Policz</Button>
      <TextBlock Name="CountText" VerticalAlignment="Center" Text="Jeszcze nie policzono." />
    </StackPanel>
    <ContentControl Name="ScreenHost" />
  </StackPanel>
</Window>
