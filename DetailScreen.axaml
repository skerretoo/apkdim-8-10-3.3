<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="katalog.DetailScreen">
  <StackPanel Margin="10" Spacing="8">
    <TextBlock Text="Szczegóły pozycji" FontSize="20" />
    <ComboBox Name="PickerBox" Width="400" SelectionChanged="OnPickerChanged" />
    <TextBlock Text="Tytuł:" FontWeight="Bold" />
    <TextBlock Name="TitleText" Text="—" />
    <TextBlock Text="Rok wydania:" FontWeight="Bold" />
    <TextBlock Name="YearText" Text="—" />
    <TextBlock Text="Ocena:" FontWeight="Bold" />
    <TextBlock Name="RatingText" Text="—" />
    <TextBlock Name="ErrorText" />
  </StackPanel>
</UserControl>
